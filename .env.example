# NEXUS AI SUPPORT — ENVIRONMENT TEMPLATE
# Copy to .env and configure your private credentials.

APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=0

SECRET_KEY=
NEXUS_ADMIN_KEY=

# Keep SQLite active until migration is explicitly approved ('sqlite' or 'firestore')
STORAGE_BACKEND=sqlite

# Firebase / Google Cloud Firestore
FIREBASE_PROJECT_ID=nexus-ai-support-8efec
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_STORAGE_BUCKET=

# Vercel Blob Storage (Private attachments in cloud preview & production)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Gemini Speech-to-Text
GEMINI_API_KEY=
GEMINI_STT_MODEL=

# Optional LLM provider
OPENAI_API_KEY=

# Gmail SMTP Contact Notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=kushwahmitansh@gmail.com
MAIL_PASSWORD=
CONTACT_RECIPIENT=kushwahmitansh@gmail.com

# Frontend and CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Upload and session settings
MAX_CONTENT_LENGTH=16777216
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
